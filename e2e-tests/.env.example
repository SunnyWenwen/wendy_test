# Copy this file to .env and fill in values for the DEV environment.
# .env is gitignored — never commit real credentials.

# LLM Gateway endpoint (API6 ai-proxy-multi entry point)
GATEWAY_BASE_URL=https://llm-gateway.dev.example.com
GATEWAY_API_KEY=your-api-key-here

# Kubernetes context for log validation
K8S_NAMESPACE=llm-gateway
LITELLM_POD_LABEL=app=litellm
AI_PROXY_POD_LABEL=app=ai-proxy-multi
# KUBECONFIG=/path/to/kubeconfig   # omit to use default ~/.kube/config

# Test tuning
REQUEST_TIMEOUT=120.0
LOG_TAIL_LINES=200
LOG_CAPTURE_DELAY=2.0
ENABLE_LOG_VALIDATION=true
