# Copy this file to .env and fill in values for the DEV environment.
# .env is gitignored — never commit real credentials.

# LLM Gateway endpoint (API6 ai-proxy-multi entry point)
GATEWAY_BASE_URL=http://testhost
GATEWAY_API_KEY=XXXX

# Default models (must match aliases in config/models.yaml)
DEFAULT_BEDROCK_MODEL=claude-sonnet-4.5
DEFAULT_VERTEX_MODEL=gemini-3.1-flash-lite-preview
DEFAULT_REASONING_MODEL=claude-sonnet-4.6

# Kubernetes context for log validation
K8S_NAMESPACE=icgs
LITELLM_POD_PREFIX=litellm          # pod name starts with this (random suffix is ignored)
AI_PROXY_POD_PREFIX=apisix          # pod name starts with this (API6/Apisix gateway)
# KUBECONFIG=/path/to/kubeconfig    # omit to use default ~/.kube/config

# Test tuning
REQUEST_TIMEOUT=120.0
LOG_TAIL_LINES=200
LOG_CAPTURE_DELAY=2.0
ENABLE_LOG_VALIDATION=true
